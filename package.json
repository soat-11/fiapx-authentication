{
  "name": "fiapx-auth-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "prebuild": "rm -rf ./dist && rm -rf auth-service.zip",
    "build": "esbuild src/handlers/*.ts --bundle --minify --sourcemap --platform=node --target=node18 --outdir=dist",
    "zip": "cd dist && zip ../zips/signup.zip signup.js && zip ../zips/login.zip login.js",
    "deploy-prep": "npm run build && npm run zip",
    "offline": "npm run build && serverless offline",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.980.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.160",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.2.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.27.2",
    "jest": "^30.2.0",
    "serverless": "^4.31.2",
    "serverless-localstack": "^1.3.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
